# Copy this file to ".env" and fill it in. Lines starting with # are notes.

# AI helper keys are best pasted into the app (Settings, AI helper).
# You can also put them here instead. Both are optional.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Models used for captions. The defaults are fine.
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-3.5-flash

# Where the control panel runs. Leave HOST alone if you use it on the same computer.
PORT=3000
HOST=127.0.0.1

# Only if you run the app on a server and open the panel from another device: set HOST=0.0.0.0
# and choose an ADMIN_PASSWORD below. (Docker sets HOST for you.)

# ----- Accounts (several people using the app) -----
# The first account is called "admin". This is its password (at least 8 characters).
# It is only used the very first time the app starts; change it later in Settings, Your account.
# Leave it empty on a phone that only you use: then there is nothing to sign in to.
ADMIN_PASSWORD=

# ----- Running on a server (see DEPLOY.md) -----
# Your web address, for example poster.example.com (it must point at the server).
DOMAIN=
